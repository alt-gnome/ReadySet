using Gtk 4.0;
using Adw 1;
using Vte 2.91;

template $ReadySetInstallerEndPage: $ReadySetEndPage {
  Stack stack {
    transition-duration: 300;
    transition-type: crossfade;

    StackPage {
      name: "applying";

      child: Adw.ToastOverlay toast_overlay {
        Box {
          orientation: vertical;

          Overlay {
            ScrolledWindow {
              propagate-natural-height: true;
              hscrollbar-policy: never;

              Box {
                orientation: vertical;
                spacing: 48;
                valign: center;
                hexpand: true;
                vexpand: true;

                $ReadySetStatusPage icon_status_page {
                  styles [
                    "accent",
                  ]
                }

                $ReadySetStatusPage main_status_page {
                  title: _("Installing system…");
                  description: _("This could take a while. Don’t turn of a computer.");
                }

                Adw.Clamp {
                  maximum-size: 450;
                  margin-start: 12;
                  margin-end: 12;
                  margin-bottom: 12;

                  Box {
                    spacing: 12;
                    orientation: vertical;

                    Box progress_box {
                      styles [
                        "accent",
                      ]

                      orientation: vertical;

                      Revealer progress_revealer {
                        reveal-child: false;

                        ProgressBar progress_bar {
                          margin-bottom: 12;
                        }
                      }

                      Box {
                        Label description_label {
                          visible: bind $description_label_is_not_empty(
                            description_label.label,
                            global_percentage_label.visible
                            ) as <bool>;
                          hexpand: true;
                          xalign: 0.0;
                        }

                        Label global_percentage_label {
                          use-markup: true;
                          halign: end;
                        }
                      }
                    }

                    Separator {
                      orientation: horizontal;
                    }

                    ListBox stages_box {
                      styles [
                        "stages-box",
                      ]

                      selection-mode: none;
                    }
                  }
                }
              }
            }

            [overlay]
            Revealer log_btn_revealer {
              reveal-child: false;
              transition-type: crossfade;
              transition-duration: 300;
              halign: end;
              valign: end;

              Button log_btn {
                tooltip-text: _("Detailed information");
                icon-name: "utilities-terminal-symbolic";
                margin-bottom: 12;
                margin-start: 6;
                margin-top: 6;
                margin-end: 12;
                halign: end;
                valign: center;
                clicked => $toggle_log();

                Adw.ButtonContent {
                  icon-name: "utilities-terminal-symbolic";
                  label: _("Detailed information");
                }
              }
            }
          }

          Revealer log_revealer {
            reveal-child: false;

            Box {
              orientation: vertical;

              Separator {
                orientation: horizontal;
              }

              Overlay {
                ScrolledWindow {
                  height-request: 300;

                  Vte.Terminal logs_view {
                    input-enabled: false;
                    scrollback-lines: 10_000;
                    scroll-on-output: true;
                    allow-bold: true;
                  }
                }

                [overlay]
                Button {
                  styles [
                    "background",
                  ]

                  tooltip-text: _("Hide logs");
                  icon-name: "utilities-terminal-symbolic";
                  halign: end;
                  valign: start;
                  margin-end: 12;
                  margin-top: 12;
                  clicked => $toggle_log();

                  Adw.ButtonContent {
                    icon-name: "utilities-terminal-symbolic";
                    label: _("Hide logs");
                  }
                }
              }
            }
          }
        }
      };
    }

    StackPage {
      name: "ready";

      child: Adw.StatusPage status_page {
        icon-name: "ready-to-go";
        title: _("All done!");

        Box {
          spacing: 24;
          halign: center;

          Button quit_button {
            styles [
              "pill",
            ]

            label: _("Continue using live system");
            use-underline: true;
            halign: center;
            width-request: 156;
            can-shrink: true;
            action-name: "app.finish";
            action-target: "'quit'";
          }

          Button reboot_button {
            styles [
              "pill",
              "suggested-action",
            ]

            label: _("Reboot now");
            use-underline: true;
            halign: center;
            width-request: 156;
            can-shrink: true;
            action-name: "app.finish";
            action-target: "'reboot'";
          }
        }
      };
    }
  }
}
