using Gtk 4.0;
using Adw 1;

template $ReadySetStepsMainPage: Adw.BreakpointBin {
  width-request: 360;
  height-request: 294;

  Adw.Breakpoint big_breakpoint {
    condition ("min-height: 400px and min-width: 719px")

    setters {
      mlv.layout-name: "regular";
      template.layout-mode: big;
    }
  }

  Adw.Breakpoint small_breakpoint {
    condition ("max-height: 400px and max-width: 719px")

    setters {
      template.is-compact: true;
      mlv.layout-name: "vertical";
      info_positioned_stack.transition-type: slide-left-right;
      template.layout-mode: small;
    }
  }

  Adw.Breakpoint vertical_breakpoint {
    condition ("min-height: 400px and max-width: 719px")

    setters {
      mlv.layout-name: "vertical";
      info_positioned_stack.transition-type: slide-left-right;
      template.layout-mode: vertical;
    }
  }

  Adw.Breakpoint horizontal_breakpoint {
    condition ("max-height: 400px and min-width: 719px")

    setters {
      template.is-compact: true;
      mlv.layout-name: "horizontal";
      template.layout-mode: horizontal;
    }
  }

  Stack main_stack {
    transition-type: crossfade;
    transition-duration: 300;

    StackPage {
      name: "main";

      child: Adw.MultiLayoutView mlv {
        Adw.Layout {
          name: "vertical";

          content: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {
              show-back-button: false;
              show-start-title-buttons: false;

              [start]
              Adw.LayoutSlot {
                id: "steps-button";
              }

              [start]
              Adw.LayoutSlot {
                id: "sandbox-label-left";
              }

              title-widget: Adw.LayoutSlot {
                id: "pages-indicator";
              };

              [end]
              Adw.LayoutSlot {
                id: "context-button";
              }

              [end]
              Adw.LayoutSlot {
                id: "sandbox-label-right";
              }
            }

            [top]
            Adw.LayoutSlot {
              id: "top-widget";
            }

            content: $ReadySetPositionedStack vertical_stack {
              valign: fill;
              vexpand: true;
              transition-type: slide-left-right;
            };

            [bottom]
            Adw.LayoutSlot {
              id: "bottom-widget";
            }

            [bottom]
            Adw.LayoutSlot {
              id: "bottom";
            }
          };
        }

        Adw.Layout {
          name: "regular";

          Adw.OverlaySplitView {
            pin-sidebar: true;
            min-sidebar-width: 340;
            show-sidebar: bind template.standalone inverted;

            sidebar: Adw.ToolbarView {
              extend-content-to-top-edge: true;

              [top]
              Adw.HeaderBar {
                show-title: false;

                [start]
                Adw.LayoutSlot {
                  id: "steps-button";
                }

                [start]
                Adw.LayoutSlot {
                  id: "sandbox-label-left";
                }
              }

              content: ScrolledWindow {
                propagate-natural-height: true;
                hscrollbar-policy: never;

                Adw.LayoutSlot {
                  id: "info-body";
                }
              };
            };

            content: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                show-back-button: false;
                show-start-title-buttons: false;

                [start]
                Adw.LayoutSlot {
                  id: "standalone-steps-button";
                }

                [start]
                Adw.LayoutSlot {
                  id: "standalone-sandbox-label-left";
                }

                title-widget: Adw.LayoutSlot {
                  id: "pages-indicator";
                };

                [end]
                Adw.LayoutSlot {
                  id: "context-button";
                }

                [end]
                Adw.LayoutSlot {
                  id: "sandbox-label-right";
                }
              }

              [top]
              Adw.LayoutSlot {
                id: "top-widget";
              }

              content: Adw.LayoutSlot {
                id: "main-body";
              };

              [bottom]
              Adw.LayoutSlot {
                id: "bottom-widget";
              }

              [bottom]
              Adw.LayoutSlot {
                id: "bottom";
              }
            };
          }
        }

        Adw.Layout {
          name: "horizontal";

          Adw.OverlaySplitView {
            pin-sidebar: true;
            min-sidebar-width: 340;
            show-sidebar: bind template.standalone inverted;

            sidebar: Adw.ToolbarView {
              extend-content-to-top-edge: true;

              [top]
              Adw.HeaderBar {
                show-title: false;

                [start]
                Adw.LayoutSlot {
                  id: "steps-button";
                }

                [start]
                Adw.LayoutSlot {
                  id: "sandbox-label-left";
                }
              }

              content: ScrolledWindow {
                propagate-natural-height: true;
                hscrollbar-policy: never;

                Adw.LayoutSlot {
                  id: "info-body";
                }
              };

              [bottom]
              Adw.LayoutSlot {
                id: "bottom";
              }
            };

            content: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                show-back-button: false;
                show-start-title-buttons: false;

                [start]
                Adw.LayoutSlot {
                  id: "standalone-steps-button";
                }

                [start]
                Adw.LayoutSlot {
                  id: "standalone-sandbox-label-left";
                }

                title-widget: Adw.LayoutSlot {
                  id: "pages-indicator";
                };

                [end]
                Adw.LayoutSlot {
                  id: "context-button";
                }

                [end]
                Adw.LayoutSlot {
                  id: "sandbox-label-right";
                }
              }

              [top]
              Adw.LayoutSlot {
                id: "top-widget";
              }

              content: Adw.LayoutSlot {
                id: "main-body";
              };

              [bottom]
              Adw.LayoutSlot {
                id: "bottom-widget";
              }

              [bottom]
              CenterBox standalone_horizontal_bottom {
                orientation: horizontal;
                margin-bottom: 6;
                margin-top: 6;
                margin-start: 12;
                margin-end: 12;
                halign: fill;
                hexpand: true;

                start-widget: Revealer {
                  transition-type: crossfade;
                  transition-duration: 200;
                  reveal-child: bind template.can-cancel;
                  halign: end;
                  hexpand: true;

                  Button {
                    styles [
                      "circular",
                    ]

                    tooltip-text: _("Go to previous page");
                    icon-name: "go-previous-symbolic";
                    can-shrink: true;
                    width-request: 32;
                    height-request: 32;
                    clicked => $cancel_clicked();
                    valign: center;
                    margin-end: 12;
                  }
                };

                center-widget: Button {
                  styles [
                    "suggested-action",
                  ]

                  halign: center;
                  sensitive: bind template.is-ready-to-continue;
                  label: _("Next");
                  width-request: 156;
                  clicked => $continue_clicked();
                };

                end-widget: Button {
                  styles [
                    "circular",
                    "flat",
                  ]

                  icon-name: "keyboard-symbolic";
                  tooltip-text: _("Extend/Retract keyboard");
                  visible: bind osk_button.visible;
                  width-request: 32;
                  height-request: 32;
                  valign: center;
                  clicked => $osk_clicked();
                  margin-start: 12;
                };
              }
            };
          }
        }

        [steps-button]
        Adw.Bin {
          ToggleButton steps_list_button {
            styles [
              "flat",
            ]

            action-name: "wincon.show-sidebar";
            icon-name: "view-list-symbolic";
            valign: start;
            visible: bind steps_list_button.sensitive;
          }
        }

        [sandbox-label-left]
        Label sandbox_label_left {
          styles [
            "warning",
          ]

          margin-start: 12;
          margin-end: 12;
          visible: false;
          label: "s&box";
        }

        [standalone-steps-button]
        Adw.Bin {
          ToggleButton standalone_steps_list_button {
            styles [
              "flat",
            ]

            action-name: "wincon.show-sidebar";
            icon-name: "view-list-symbolic";
            visible: bind $and(steps_list_button.visible, template.standalone) as <bool>;
            valign: start;
          }
        }

        [standalone-sandbox-label-left]
        Label standalone_sandbox_label {
          styles [
            "warning",
          ]

          margin-start: 12;
          margin-end: 12;
          visible: false;
          label: "s&box";
        }

        [pages-indicator]
        $ReadySetPagesIndicator pages_indicator {
          vexpand: true;
          valign: center;
          show-icons: false;
          model: bind template.model;
        }

        [context-button]
        Adw.Bin {
          Button context_button {
            styles [
              "flat",
            ]

            action-name: "app.show-devel-window";
            visible: bind context_button.sensitive;
            tooltip-text: _("Open Context menu");
            icon-name: "open-menu-symbolic";
          }
        }

        [sandbox-label-right]
        Label sandbox_label_right {
          styles [
            "warning",
          ]

          margin-start: 12;
          margin-end: 12;
          visible: false;
          label: "s&box";
        }

        [main-body]
        $ReadySetPositionedStack positioned_stack {
          transition-type: slide-left-right;
        }

        [info-body]
        $ReadySetPositionedStack info_positioned_stack {
          visible: bind template.standalone inverted;
          vexpand: false;
          transition-type: crossfade;
        }

        [top-widget]
        Adw.Bin top_bin {}

        [bottom-widget]
        Adw.Bin bottom_bin {}

        [bottom]
        CenterBox button_center_box {
          orientation: horizontal;
          margin-bottom: 12;
          margin-top: 6;
          margin-start: 12;
          margin-end: 12;
          halign: fill;
          hexpand: true;

          start-widget: Revealer {
            transition-type: crossfade;
            transition-duration: 200;
            reveal-child: bind template.can-cancel;
            halign: end;
            hexpand: true;

            Button go_prev_button {
              styles [
                "circular",
              ]

              tooltip-text: _("Go to previous page");
              icon-name: "go-previous-symbolic";
              can-shrink: true;
              width-request: 48;
              height-request: 48;
              clicked => $cancel_clicked();
              valign: center;
              margin-end: 12;
            }
          };

          center-widget: Button go_next_button {
            styles [
              "pill",
              "suggested-action",
            ]

            halign: center;
            sensitive: bind template.is-ready-to-continue;
            label: _("Next");
            width-request: 156;
            clicked => $continue_clicked();
          };

          end-widget: Button osk_button {
            styles [
              "circular",
              "flat",
            ]

            focusable: false;
            icon-name: "keyboard-symbolic";
            tooltip-text: _("Extend/Retract keyboard");
            width-request: 48;
            height-request: 48;
            valign: center;
            clicked => $osk_clicked();
            margin-start: 12;
          };
        }
      };
    }

    StackPage {
      name: "end";

      child: Adw.ToolbarView page_toolbar {
        [top]
        Adw.HeaderBar {
          show-title: false;

          [start]
          Button end_page_back_button {
            icon-name: "go-previous-symbolic";
            tooltip-text: _("Return to setup");
            visible: false;
            clicked => $to_main();
          }

          [end]
          Button {
            styles [
              "flat",
            ]

            action-name: "app.show-devel-window";
            visible: bind context_button.visible;
            tooltip-text: _("Open Context menu");
            icon-name: "open-menu-symbolic";
          }
        }
      };
    }
  }
}
