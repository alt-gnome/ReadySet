#!/usr/bin/bash -ex

RAW_PATH=
FORCE_REBUILD=false
LOCAL_IMAGE=localhost/ready-set-atomic

TMPDIR=$PWD/.vagary/tmp
mkdir -p "$TMPDIR"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --force-rebuild) FORCE_REBUILD=true; shift ;;
        --out)
            [[ $# -ge 2 ]] || { echo "--out requires a path" >&2; exit 2; }
            RAW_PATH="$2"
            shift 2
            ;;
        --out=*) RAW_PATH="${1#--out=}"; shift ;;
        *) IMAGE_ARG="$1"; shift ;;
    esac
done

sudo rm -f test-atomic/*/image.raw

if [[ "$FORCE_REBUILD" == true ]] || ! podman image exists $LOCAL_IMAGE; then
    rm -rf "$RAW_PATH"
    sudo rm -rf "$TMPDIR"/*

    podman build \
        --tag $LOCAL_IMAGE \
        --build-arg "IMAGE=$IMAGE_ARG" \
        --file test-atomic/Containerfile \
        .
fi

truncate -s 15G $RAW_PATH

if [[ "$FORCE_REBUILD" == true ]] || ! sudo podman image exists $LOCAL_IMAGE; then
    podman save "$LOCAL_IMAGE" | sudo env TMPDIR=$TMPDIR podman load
fi

sudo env TMPDIR=$TMPDIR \
    podman run --rm --privileged --pid=host \
        -v /var/lib/containers:/var/lib/containers \
        -v /dev:/dev \
        -v "$PWD:/output" \
        "$LOCAL_IMAGE" \
        bootc install to-disk \
            --generic-image \
            --via-loopback \
            --filesystem ext4 \
            --disable-selinux \
            "/output/$RAW_PATH"
