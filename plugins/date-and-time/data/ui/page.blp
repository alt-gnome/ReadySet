using Gtk 4.0;
using Adw 1;

template $DateAndTimePage: $ReadySetBasePage {
  title-header: _("Date & Time");
  notify::time-selected => $update_is_ready();
  notify::date-selected => $update_is_ready();

  info: $ReadySetStatusPage {
    title: _("Date & Time");
    description: _("Select your time zone.");
    icon-name: "preferences-system-time-symbolic";
  };

  content: Adw.Clamp {
    margin-start: 12;
    margin-end: 12;
    margin-top: 12;
    margin-bottom: 12;

    Box {
      orientation: vertical;
      spacing: 12;

      Box {
        orientation: vertical;
        spacing: 9;

        Adw.PreferencesGroup {
          title: _("Set time zone");

          Adw.SwitchRow auto_timezone_switch {
            title: _("Automatic setting of time zone");
            active: bind template.manual-timezone bidirectional inverted;
          }

          Adw.ActionRow timezone_row {
            activated => $on_timezone_row_clicked();
            activatable: true;
            sensitive: bind auto_timezone_switch.active inverted;
            title: _("Time zone");
            subtitle: bind template.timezone_label;

            [suffix]
            Image {
              icon-name: "go-next-symbolic";
            }
          }
        }
      }

      Box {
        orientation: vertical;
        spacing: 9;

        Adw.PreferencesGroup {
          title: _("Set date and time");

          Adw.SwitchRow auto_date_and_time_switch {
            title: _("Automatic setting of date and time");
            active: bind template.manual-date-and-time bidirectional inverted;
          }

          Adw.ActionRow date_row {
            activated => $on_date_row_clicked();
            activatable: true;
            title: _("Date");
            subtitle: bind template.date_label;
            sensitive: bind auto_date_and_time_switch.active inverted;

            [suffix]
            Image {
              icon-name: "go-next-symbolic";
            }
          }

          Adw.ActionRow time_row {
            activated => $on_time_row_clicked();
            activatable: true;
            title: _("Time");
            subtitle: bind template.time_label;
            sensitive: bind auto_date_and_time_switch.active inverted;

            [suffix]
            Image {
              icon-name: "go-next-symbolic";
            }
          }
        }
      }
    }
  };
}
