using Gtk 4.0;
using Adw 1;

template $NetworkAccessPointPasswordDialog: Adw.AlertDialog {
  responses [
    cancel: _("Cancel"),
    apply: _("Apply") suggested disabled,
  ]

  default-response: "apply";
  close-response: "cancel";
  can-close: true;

  Adw.PreferencesGroup {
    Adw.EntryRow {
      title: _("Username");
      visible: bind template.needs_username;
      text: bind template.username bidirectional;
      entry-activated => $username_entered();
    }

    Adw.PasswordEntryRow {
      title: _("Password");
      text: bind template.password bidirectional;
      max-length: 64;
      activates-default: true;
    }
  }
}
