using Gtk 4.0;
using Adw 1;

template $NetworkModeledStack: Adw.Bin {
  Stack _stack {}

  hhomogeneous: bind _stack.hhomogeneous bidirectional;
  interpolate-size: bind _stack.interpolate-size bidirectional;
  transition-duration: bind _stack.transition-duration bidirectional;
  transition-type: bind _stack.transition-type bidirectional;
  vhomogeneous: bind _stack.vhomogeneous bidirectional;
  visible-child: bind _stack.visible-child bidirectional;
  visible-child-name: bind _stack.visible-child-name bidirectional;
}
