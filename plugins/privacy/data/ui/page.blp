using Gtk 4.0;
using Adw 1;

template $PrivacyPage: $ReadySetBasePage {
  title-header: _("Privacy");
  title-icon-name: "preferences-system-privacy-symbolic";
  is-ready: true;

  info: $ReadySetStatusPage {
    title: _("Privacy");
    icon-name: "preferences-system-privacy-symbolic";
  };

  content: Adw.Clamp {
    margin-start: 12;
    margin-end: 12;

    Box {
      orientation: vertical;
      spacing: 12;

      ListBox {
        styles [
          "boxed-list",
        ]

        selection-mode: none;

        Adw.SwitchRow location_row {
          title: _("Location Services");
        }
      }

      Label {
        styles [
          "caption",
        ]

        label: _("Allows apps to determine your geographical location.");
        xalign: 0;
        wrap: true;
        wrap-mode: word_char;
        halign: start;
      }
    }
  };
}
